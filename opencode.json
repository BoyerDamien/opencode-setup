{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama-cloud/deepseek-v4-pro",
  "default_agent": "controller",
  "instructions": [
    "AGENTS.md",
    "instructions/secrets.md",
    "instructions/anti-hallucination.md",
    "instructions/pedagogic-style.md"
  ],
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true
    }
  },
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "webfetch": "ask",
    "websearch": "allow",
    "exa_*": "deny",
    "context7_*": "deny"
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "preserve_recent_tokens": 4000,
    "reserved": 2000
  }
}
