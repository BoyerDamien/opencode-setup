{
  "$schema": "https://opencode.ai/config.json",
  "model": "amazon-bedrock/eu.anthropic.claude-sonnet-5",
  "default_agent": "controller",
  "provider": {
    "amazon-bedrock": {
      "options": {
        "profile": "genai-production:Admin",
        "region": "eu-west-3"
      }
    }
  },
  "instructions": [
    "AGENTS.md",
    "instructions/secrets.md",
    "instructions/anti-hallucination.md",
    "instructions/pedagogic-style.md"
  ],
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true
    },
    "datadog": {
      "type": "remote",
      "url": "https://mcp.datadoghq.eu/api/unstable/mcp-server/mcp",
      "enabled": true
    },
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp",
      "enabled": true
    },
    "slack": {
      "type": "remote",
      "url": "https://mcp.slack.com/mcp",
      "enabled": true,
      "oauth": {
        "clientId": "1601185624273.8899143856786",
        "redirectUri": "http://localhost:3118/callback"
      }
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true
    },
    "lsp": {
      "type": "local",
      "command": ["/home/dboyer/.local/share/mise/shims/agent-lsp", "--config", "/home/dboyer/.config/opencode/agent-lsp.json"],
      "enabled": true
    }
  },
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "webfetch": "ask",
    "websearch": "allow",
    "exa_*": "deny",
    "context7_*": "deny",
    "lsp_*": "deny"
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "preserve_recent_tokens": 4000,
    "reserved": 2000
  }
}
